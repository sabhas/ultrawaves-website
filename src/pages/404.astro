---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { site } from "../content/site";
---

<BaseLayout title="404 — Page Not Found | Ultra Wave Technologies">
  <Header />
  <main class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-surface dark:bg-surface-dark pt-16">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 text-center">
      <div class="text-8xl sm:text-9xl font-extrabold text-brand-blue/20 dark:text-brand-blue/10 select-none">
        404
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary dark:text-text-dark-primary mt-4 mb-4">
        Page Not Found
      </h1>
      <p class="text-lg text-text-secondary dark:text-text-dark-secondary mb-8 max-w-md mx-auto leading-relaxed">
        The page you're looking for doesn't exist or has been moved.
        Let us help you find what you need.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-brand-navy dark:bg-brand-blue px-8 py-3.5 text-base font-semibold text-white hover:bg-brand-navy-dark dark:hover:bg-brand-blue-dark transition-all shadow-lg hover:shadow-xl"
        >
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Home
        </a>
        <a
          href="/#contact"
          class="inline-flex items-center justify-center rounded-lg border border-border dark:border-border-dark px-8 py-3.5 text-base font-semibold text-text-primary dark:text-text-dark-primary hover:bg-surface-secondary dark:hover:bg-surface-dark-secondary transition-all"
        >
          Contact Us
        </a>
      </div>
      <p class="mt-10 text-sm text-text-tertiary dark:text-text-dark-tertiary">
        {site.name} &mdash; {site.focus}
      </p>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
