---
import { site } from "../content/site";
import logoWithText from "../assets/web/logo-with-text.png";
import { Image } from "astro:assets";
---

<section
  id="hero"
  class="relative min-h-screen flex items-start circuit-pattern animate-gradient overflow-hidden pt-24 sm:pt-28"
  aria-label="Hero"
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-12 left-8 w-24 h-24 rounded-full bg-brand-blue/5 animate-float-slow blur-xl" />
    <div class="absolute bottom-20 right-12 w-32 h-32 rounded-full bg-brand-orange/5 animate-float blur-xl" />
    <div class="absolute top-1/3 right-1/4 w-16 h-16 rounded-full bg-brand-blue/5 animate-float-delayed blur-lg" />
    <div class="absolute bottom-1/4 left-1/4 w-20 h-20 rounded-full bg-brand-orange/5 animate-float-slow blur-lg" />

    <div class="absolute top-0 left-0 w-1/2 h-1/2 opacity-20">
      <svg viewBox="0 0 400 400" class="w-full h-full text-brand-blue" fill="none">
        <path d="M0 200 H100 L120 180 L140 200 L200 200" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-dasharray="8 4" class="animate-float" />
        <path d="M50 100 H150 L170 80 L190 100 L250 100" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-dasharray="6 3" class="animate-float-delayed" />
        <circle cx="100" cy="200" r="4" fill="currentColor" opacity="0.5" class="animate-pulse-glow" />
        <circle cx="150" cy="100" r="4" fill="currentColor" opacity="0.5" class="animate-pulse-glow" style="animation-delay: 1s" />
        <circle cx="200" cy="200" r="4" fill="currentColor" opacity="0.5" class="animate-pulse-glow" style="animation-delay: 2s" />
      </svg>
    </div>
    <div class="absolute bottom-0 right-0 w-1/2 h-1/2 opacity-20 rotate-180">
      <svg viewBox="0 0 400 400" class="w-full h-full text-brand-blue" fill="none">
        <path d="M0 200 H100 L120 180 L140 200 L200 200" stroke="currentColor" stroke-width="1.5" opacity="0.4" stroke-dasharray="8 4" class="animate-float" />
        <circle cx="100" cy="200" r="4" fill="currentColor" opacity="0.5" class="animate-pulse-glow" />
        <circle cx="200" cy="200" r="4" fill="currentColor" opacity="0.5" class="animate-pulse-glow" style="animation-delay: 1.5s" />
      </svg>
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12 lg:pb-16">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      <div data-animate="fade-in-up">
        <Image
          src={logoWithText}
          alt="Ultra Wave Technologies"
          width={775}
          height={537}
          class="mt-6 sm:mt-8 lg:mt-10 h-32 sm:h-40 lg:h-48 w-auto object-contain mb-6"
          loading="eager"
        />
      </div>

      <p data-animate="fade-in-up" data-animate-delay="100" class="text-brand-blue font-semibold text-lg sm:text-xl mb-2 tracking-wide">
        {site.tagline}
      </p>

      <h1 data-animate="fade-in-up" data-animate-delay="200" class="text-3xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-4">
        {site.name}
      </h1>

      <p data-animate="fade-in-up" data-animate-delay="300" class="text-lg sm:text-xl text-gray-600 max-w-2xl mb-2 font-serif">
        {site.focus}
      </p>

      <p data-animate="fade-in-up" data-animate-delay="400" class="text-base text-gray-500 max-w-xl mb-10">
        {site.description}
      </p>

      <div data-animate="fade-in-up" data-animate-delay="500" class="flex flex-col sm:flex-row gap-4">
        <a
          href="#services"
          class="btn-pulse inline-flex items-center justify-center rounded-lg bg-brand-blue px-8 py-3.5 text-base font-semibold text-white hover:bg-brand-blue-dark transition-colors shadow-lg shadow-brand-blue/20"
        >
          Our Services
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-lg border-2 border-brand-orange px-8 py-3.5 text-base font-semibold text-brand-orange hover:bg-brand-orange hover:text-white transition-colors hover:shadow-lg hover:shadow-brand-orange/20"
        >
          {site.cta}
        </a>
      </div>
    </div>
  </div>
</section>
