---
import { site } from "../content/site";
import logoWithText from "../assets/web/logo-with-text.png";
import { Image } from "astro:assets";
---


<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-surface via-surface-secondary to-surface-tertiary dark:from-surface-dark dark:via-surface-dark-secondary dark:to-surface-dark-tertiary"
  aria-label="Hero"
>
  <!-- Animated gradient orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div id="orb-1" class="absolute -top-1/2 -left-1/2 w-full h-full parallax-orb">
      <div class="w-[600px] h-[600px] rounded-full bg-brand-blue/8 blur-[120px] animate-pulse-slow" />
    </div>
    <div id="orb-2" class="absolute -bottom-1/2 -right-1/2 w-full h-full parallax-orb">
      <div class="w-[500px] h-[500px] rounded-full bg-brand-gold/6 blur-[100px] animate-pulse-slower" />
    </div>
    <div id="orb-3" class="absolute top-1/3 right-1/4 parallax-orb">
      <div class="w-[300px] h-[300px] rounded-full bg-brand-navy/8 blur-[80px]" />
    </div>
    <!-- Subtle grid pattern overlay -->
    <div class="absolute inset-0 opacity-[0.04] dark:opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, var(--grid-dot-color, #0c1e33) 1px, transparent 0); background-size: 40px 40px;" />
    <!-- Animated floating particles -->
    <div class="absolute inset-0" aria-hidden="true">
      <div class="particle particle-1" />
      <div class="particle particle-2" />
      <div class="particle particle-3" />
      <div class="particle particle-4" />
      <div class="particle particle-5" />
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32 w-full">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-border dark:border-border-dark bg-surface-secondary dark:bg-surface-dark-secondary px-4 py-1.5 text-sm font-medium text-text-secondary dark:text-text-dark-secondary mb-8">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-blue animate-pulse" aria-hidden="true" />
        {site.focus} — Dubai, UAE
      </div>

      <Image
        src={logoWithText}
        alt="Ultra Wave Technologies"
        width={775}
        height={537}
        class="h-28 sm:h-36 lg:h-44 w-auto object-contain mb-8 opacity-90 hero-logo brightness-0 dark:brightness-100"
        loading="eager"
      />

      <p class="text-text-primary dark:text-brand-gold-light font-semibold text-lg sm:text-xl mb-3 tracking-wide">
        {site.tagline}
      </p>

      <p class="text-lg sm:text-xl text-text-secondary dark:text-text-dark-secondary max-w-2xl mb-10 leading-relaxed">
        {site.description}
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#services"
          class="inline-flex items-center justify-center rounded-lg bg-brand-blue px-8 py-3.5 text-base font-semibold text-white hover:bg-brand-blue-dark transition-all shadow-lg shadow-brand-blue/25 hover:shadow-xl hover:shadow-brand-blue/30 hover:-translate-y-0.5"
        >
          Our Services
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-lg border border-border dark:border-border-dark px-8 py-3.5 text-base font-semibold text-text-primary dark:text-text-dark-primary hover:bg-surface-secondary dark:hover:bg-surface-dark-secondary transition-all hover:-translate-y-0.5"
        >
          {site.cta}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce-slow" aria-hidden="true">
    <span class="text-xs font-medium text-text-tertiary dark:text-text-dark-tertiary tracking-widest uppercase">Scroll</span>
    <svg class="h-4 w-4 text-text-tertiary dark:text-text-dark-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7" />
    </svg>
  </div>
</section>

<style>
  #hero {
    --grid-dot-color: #0c1e33;
  }
  .dark #hero {
    --grid-dot-color: #94a3b8;
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  @keyframes pulse-slower {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.15); }
  }
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0) translateX(-50%); }
    50% { transform: translateY(6px) translateX(-50%); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  @keyframes particle-drift-1 {
    0% { transform: translate(0, 0) scale(1); opacity: 0; }
    20% { opacity: 0.6; }
    80% { opacity: 0.6; }
    100% { transform: translate(100px, -80px) scale(0); opacity: 0; }
  }
  @keyframes particle-drift-2 {
    0% { transform: translate(0, 0) scale(1); opacity: 0; }
    20% { opacity: 0.4; }
    80% { opacity: 0.4; }
    100% { transform: translate(-80px, -120px) scale(0); opacity: 0; }
  }
  @keyframes particle-drift-3 {
    0% { transform: translate(0, 0) scale(1); opacity: 0; }
    20% { opacity: 0.5; }
    80% { opacity: 0.5; }
    100% { transform: translate(60px, -100px) scale(0); opacity: 0; }
  }
  @keyframes particle-drift-4 {
    0% { transform: translate(0, 0) scale(1); opacity: 0; }
    20% { opacity: 0.3; }
    80% { opacity: 0.3; }
    100% { transform: translate(-120px, -60px) scale(0); opacity: 0; }
  }
  @keyframes particle-drift-5 {
    0% { transform: translate(0, 0) scale(1); opacity: 0; }
    20% { opacity: 0.5; }
    80% { opacity: 0.5; }
    100% { transform: translate(40px, -140px) scale(0); opacity: 0; }
  }
  .animate-pulse-slow { animation: pulse-slow 6s ease-in-out infinite; }
  .animate-pulse-slower { animation: pulse-slower 8s ease-in-out infinite; }
  .animate-bounce-slow { animation: bounce-slow 2s ease-in-out infinite; }
  .hero-logo { animation: float 4s ease-in-out infinite; }

  /* Floating particles */
  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-brand-blue);
    opacity: 0;
    pointer-events: none;
  }
  .particle-1 { left: 20%; top: 30%; animation: particle-drift-1 8s ease-in-out infinite; animation-delay: 0s; }
  .particle-2 { left: 70%; top: 50%; animation: particle-drift-2 10s ease-in-out infinite; animation-delay: 2s; }
  .particle-3 { left: 40%; top: 60%; animation: particle-drift-3 7s ease-in-out infinite; animation-delay: 4s; }
  .particle-4 { left: 85%; top: 25%; animation: particle-drift-4 9s ease-in-out infinite; animation-delay: 1s; }
  .particle-5 { left: 10%; top: 70%; animation: particle-drift-5 11s ease-in-out infinite; animation-delay: 3s; }

  /* Scroll-driven parallax for hero orbs (progressive enhancement) */
  @supports (animation-timeline: scroll()) {
    .parallax-orb {
      animation: orb-parallax linear;
      animation-timeline: scroll(root);
    }
    #orb-1 { animation-range: 0 100vh; }
    #orb-2 { animation-range: 0 100vh; }
    #orb-3 { animation-range: 0 80vh; }
    @keyframes orb-parallax {
      from { transform: translateY(0); }
      to { transform: translateY(120px); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo,
    .particle {
      animation: none !important;
      opacity: 0;
    }
    .parallax-orb {
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    // ── Mouse parallax for gradient orbs ──
    const hero = document.getElementById("hero");
    const orbs = hero?.querySelectorAll(".parallax-orb");
    if (!hero || !orbs || orbs.length === 0) return;

    let rafId = null;
    let mouseX = 0;
    let mouseY = 0;
    let currentX = 0;
    let currentY = 0;

    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      mouseY = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
      if (!rafId) rafId = requestAnimationFrame(updateOrbs);
    });

    hero.addEventListener("mouseleave", () => {
      mouseX = 0;
      mouseY = 0;
      if (!rafId) rafId = requestAnimationFrame(updateOrbs);
    });

    function updateOrbs() {
      rafId = null;
      // Smooth interpolate
      currentX += (mouseX - currentX) * 0.1;
      currentY += (mouseY - currentY) * 0.1;

      if (orbs.length >= 1) {
        orbs[0].style.transform = `translate(${currentX * -20}px, ${currentY * -15}px)`;
      }
      if (orbs.length >= 2) {
        orbs[1].style.transform = `translate(${currentX * 15}px, ${currentY * 20}px)`;
      }
      if (orbs.length >= 3) {
        orbs[2].style.transform = `translate(${currentX * -10}px, ${currentY * -10}px)`;
      }

      if (Math.abs(currentX) > 0.01 || Math.abs(currentY) > 0.01) {
        rafId = requestAnimationFrame(updateOrbs);
      }
    }
  })();
</script>
