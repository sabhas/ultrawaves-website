  web: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  marketing: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z",
};
---

<section id="services" class="py-12 lg:py-16" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-in-up" class="text-center mb-10">
      <span class="text-6xl sm:text-8xl font-bold text-gray-200 block leading-none select-none" aria-hidden="true">OUR</span>
      <h2 id="services-heading" class="text-3xl sm:text-4xl font-bold text-brand-blue -mt-8 sm:-mt-12 relative">
        Services
      </h2>
      <p class="mt-4 text-gray-600 max-w-2xl mx-auto font-serif">
        Comprehensive IT and networking solutions designed to empower your business.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {
        serviceOverview.map((service, i) => (
          <a
            href={`#${service.id}`}
            data-animate="fade-in-up"
            data-animate-delay={i * 100}
            class="group flex flex-col rounded-xl border border-gray-100 bg-white p-6 shadow-sm hover:shadow-md hover:border-brand-blue/20 transition-all hover-lift"
          >
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-brand-blue/10 text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition-all duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[service.id] ?? icons.cabling} />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-brand-blue transition-colors">
              {service.title}
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed flex-1">{service.description}</p>
            <span class="mt-4 text-sm font-medium text-brand-orange group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              Learn more
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
