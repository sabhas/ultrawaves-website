---
import { serviceOverview } from "../content/services";

const icons: Record<string, string> = {
  cabling: "M13 10V3L4 14h7v7l9-11h-7z",
  cctv: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z",
  pabx: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  wifi: "M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01M7.05 7.05a10 10 0 0114 0M4.222 10.222a14 14 0 0115.556 0",
  access: "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z",
  intercom: "M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z",
  automation: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  amc: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
  web: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  marketing: "M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z",
};

const categories: Record<string, { label: string; color: string }> = {
  cabling: { label: "Infrastructure", color: "bg-brand-blue/10 text-brand-blue dark:bg-brand-blue/20" },
  cctv: { label: "Security", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  pabx: { label: "Communication", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  wifi: { label: "Infrastructure", color: "bg-brand-blue/10 text-brand-blue dark:bg-brand-blue/20" },
  access: { label: "Security", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  intercom: { label: "Security", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  automation: { label: "Innovation", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  amc: { label: "Support", color: "bg-brand-blue/10 text-brand-blue dark:bg-brand-blue/20" },
  web: { label: "Digital", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
  marketing: { label: "Digital", color: "bg-brand-gold/10 text-brand-gold dark:bg-brand-gold/20" },
};
---

<section id="services" class="py-16 lg:py-24 bg-surface dark:bg-surface-dark transition-colors" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <span class="section-label">What We Do</span>
      <h2 id="services-heading" class="section-heading">
        Our Services
      </h2>
      <span class="heading-accent mx-auto" aria-hidden="true" />
      <p class="mt-6 text-text-secondary dark:text-text-dark-secondary max-w-2xl mx-auto text-lg">
        Comprehensive IT and networking solutions designed to empower your business.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 stagger-children reveal-scale" id="services-grid">
      {
        serviceOverview.map((service) => {
          const cat = categories[service.id] ?? { label: "General", color: "bg-gray-100 text-gray-600" };
          return (
            <a
              href={`#${service.id}`}
              class="group relative flex flex-col rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark-secondary p-6 shadow-sm hover:shadow-xl hover:shadow-brand-blue/5 dark:hover:shadow-brand-blue/10 hover:-translate-y-1 hover:border-brand-blue/30 dark:hover:border-brand-blue/40 transition-all duration-300"
            >
              <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-navy/5 dark:bg-white/5 text-brand-navy dark:text-brand-blue group-hover:bg-brand-blue group-hover:text-white dark:group-hover:bg-brand-blue dark:group-hover:text-white transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-brand-blue/20">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icons[service.id] ?? icons.cabling} />
                </svg>
              </div>

              <span class={cat.color + " inline-flex self-start items-center rounded-full px-2.5 py-0.5 text-xs font-medium mb-3"}>
                {cat.label}
              </span>

              <h3 class="font-semibold text-text-primary dark:text-text-dark-primary mb-2 group-hover:text-brand-blue dark:group-hover:text-brand-blue transition-colors">
                {service.title}
              </h3>
              <p class="text-sm text-text-secondary dark:text-text-dark-secondary leading-relaxed flex-1">{service.description}</p>

              <span class="mt-4 text-sm font-medium text-text-tertiary dark:text-text-dark-tertiary group-hover:text-brand-blue dark:group-hover:text-brand-blue transition-all inline-flex items-center gap-1.5">
                Learn more
                <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Stagger animation for service cards
  const grid = document.getElementById("services-grid");
  if (grid) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15 }
    );
    observer.observe(grid);
  }
</script>
