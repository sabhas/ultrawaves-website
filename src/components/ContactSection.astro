---
import { site } from "../content/site";
import { services } from "../content/services";
import logo from "../assets/web/logo.png";
import { Image } from "astro:assets";
---

<section id="contact" class="py-16 lg:py-24 bg-surface dark:bg-surface-dark transition-colors" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <span class="section-label">Get in Touch</span>
      <h2 id="contact-heading" class="section-heading">
        {site.cta}
      </h2>
      <span class="heading-accent mx-auto" aria-hidden="true" />
      <p class="mt-6 text-text-secondary dark:text-text-dark-secondary max-w-2xl mx-auto text-lg">
        Ready to start your next project? Reach out and our team will get back to you within 24 hours.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 max-w-6xl mx-auto">
      <!-- Contact Form (3/5 width) -->
      <div class="lg:col-span-3 animate-on-scroll">
        <div class="rounded-2xl bg-surface dark:bg-surface-dark-secondary border border-border dark:border-border-dark p-8 shadow-sm">
          <h3 class="text-xl font-bold text-text-primary dark:text-text-dark-primary mb-6">Send us a Message</h3>
            <form id="contact-form" class="space-y-5" novalidate>
              <input type="hidden" name="_access_key" value="YOUR_ACCESS_KEY" />
              <input type="hidden" name="_subject" value="New Inquiry from Ultra Wave Website" />
              <input type="hidden" name="_template" value="box" />
              <div class="grid sm:grid-cols-2 gap-5">
                <div class="relative">
                  <input
                    type="text"
                    id="form-name"
                    name="name"
                    required
                    placeholder=" "
                    class="peer w-full rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 pt-6 pb-2 text-sm text-text-primary dark:text-text-dark-primary focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-all"
                    data-validate
                  />
                  <label
                    for="form-name"
                    class="absolute left-4 top-5 text-sm text-text-tertiary dark:text-text-dark-tertiary transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand-blue peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-text-tertiary"
                  >
                    Full Name *
                  </label>
                  <p class="form-error text-xs text-red-500 mt-1 hidden">Please enter your name</p>
                </div>
                <div class="relative">
                  <input
                    type="email"
                    id="form-email"
                    name="email"
                    required
                    placeholder=" "
                    class="peer w-full rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 pt-6 pb-2 text-sm text-text-primary dark:text-text-dark-primary focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-all"
                    data-validate
                  />
                  <label
                    for="form-email"
                    class="absolute left-4 top-5 text-sm text-text-tertiary dark:text-text-dark-tertiary transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand-blue peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-text-tertiary"
                  >
                    Email Address *
                  </label>
                  <p class="form-error text-xs text-red-500 mt-1 hidden">Please enter a valid email</p>
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div class="relative">
                  <input
                    type="tel"
                    id="form-phone"
                    name="phone"
                    placeholder=" "
                    class="peer w-full rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 pt-6 pb-2 text-sm text-text-primary dark:text-text-dark-primary focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-all"
                  />
                  <label
                    for="form-phone"
                    class="absolute left-4 top-5 text-sm text-text-tertiary dark:text-text-dark-tertiary transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand-blue peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-text-tertiary"
                  >
                    Phone Number
                  </label>
                </div>
                <div class="relative">
                  <select
                    id="form-service"
                    name="service"
                    required
                    class="peer w-full rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 pt-6 pb-2 text-sm text-text-primary dark:text-text-dark-primary focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-all appearance-none"
                  >
                    <option value="" selected disabled></option>
                    {services.map((s) => (
                      <option value={s.id}>{s.title}</option>
                    ))}
                    <option value="other">Other</option>
                  </select>
                  <label
                    for="form-service"
                    class="absolute left-4 top-5 text-sm text-text-tertiary dark:text-text-dark-tertiary transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand-blue peer-[:valid]:top-2 peer-[:valid]:text-xs"
                  >
                    Service Interested In
                  </label>
                  <svg class="absolute right-4 top-1/2 -translate-y-1/2 h-4 w-4 text-text-tertiary pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>

              <div class="relative">
                <textarea
                  id="form-message"
                  name="message"
                  rows={4}
                  required
                  placeholder=" "
                  class="peer w-full rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-4 pt-6 pb-2 text-sm text-text-primary dark:text-text-dark-primary focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-transparent transition-all resize-none"
                  data-validate
                ></textarea>
                <label
                  for="form-message"
                  class="absolute left-4 top-5 text-sm text-text-tertiary dark:text-text-dark-tertiary transition-all peer-focus:top-2 peer-focus:text-xs peer-focus:text-brand-blue peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs peer-[:not(:placeholder-shown)]:text-text-tertiary"
                >
                  Your Message *
                </label>
                <p class="form-error text-xs text-red-500 mt-1 hidden">Please enter your message</p>
              </div>

              <button
                type="submit"
                id="form-submit-btn"
                class="relative w-full rounded-lg bg-brand-navy dark:bg-brand-blue px-6 py-3 text-sm font-semibold text-white hover:bg-brand-navy-dark dark:hover:bg-brand-blue-dark transition-all shadow-lg shadow-brand-navy/20 dark:shadow-brand-blue/20 hover:shadow-xl hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed overflow-hidden"
              >
                <span id="submit-text" class="inline-flex items-center justify-center gap-2">
                  Send Message
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                </span>
                <span id="submit-spinner" class="hidden absolute inset-0 flex items-center justify-center">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                  </svg>
                </span>
                <span id="submit-success" class="hidden absolute inset-0 flex items-center justify-center gap-2 text-white">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  Sent!
                </span>
              </button>

              <p id="form-status" class="text-sm text-center hidden"></p>
            </form>
        </div>
      </div>

      <!-- Contact Info + Map (2/5 width) -->
      <div class="lg:col-span-2 space-y-6 animate-on-scroll visible-delay-1">
        <!-- Info Card -->
        <div class="rounded-2xl bg-surface dark:bg-surface-dark-secondary border border-border dark:border-border-dark p-8 shadow-sm">
          <div class="space-y-5">
            {site.phones.map((phone, i) => (
              <a
                href={`tel:${phone.number}`}
                class="flex items-center gap-4 group"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-blue/10 dark:bg-brand-blue/20 text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition-all" aria-hidden="true">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs text-text-tertiary dark:text-text-dark-tertiary">{phone.label}</p>
                  <span class="font-medium text-text-primary dark:text-text-dark-primary group-hover:text-brand-blue transition-colors">{phone.display}</span>
                </div>
              </a>
            ))}

            <a href={`mailto:${site.email}`} class="flex items-center gap-4 group">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-gold/10 dark:bg-brand-gold/20 text-brand-gold group-hover:bg-brand-gold group-hover:text-white transition-all" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <div>
                <p class="text-xs text-text-tertiary dark:text-text-dark-tertiary">Email</p>
                <span class="font-medium text-text-primary dark:text-text-dark-primary group-hover:text-brand-gold transition-colors break-all">{site.email}</span>
              </div>
            </a>

            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-gold/10 dark:bg-brand-gold/20 text-brand-gold shrink-0" aria-hidden="true">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <div>
                <p class="text-xs text-text-tertiary dark:text-text-dark-tertiary">Address</p>
                <address class="not-italic font-medium text-text-primary dark:text-text-dark-primary leading-relaxed">
                  {site.address.full}
                </address>
              </div>
            </div>

            <p class="text-sm text-text-tertiary dark:text-text-dark-tertiary pt-2 border-t border-border dark:border-border-dark">
              Contact Person: <span class="font-medium text-text-primary dark:text-text-dark-primary">{site.contactPerson}</span>
            </p>
          </div>
        </div>

        <!-- Map -->
        <div class="rounded-2xl overflow-hidden shadow-sm border border-border dark:border-border-dark min-h-[250px]">
          <iframe
            title="Ultra Wave Technologies location on Google Maps"
            src="https://maps.google.com/maps?q=Art+Tower+Al+Raffa+Dubai+UAE&output=embed"
            width="100%"
            height="100%"
            style="border:0; min-height: 280px;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 50%, 90% { transform: translateX(-4px); }
    30%, 70% { transform: translateX(4px); }
  }
  .input-error {
    border-color: #ef4444 !important;
    animation: shake 0.5s ease;
  }
  .dark .input-error {
    border-color: #f87171 !important;
  }
  .input-error:focus {
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.3) !important;
  }
  @keyframes draw-check {
    to { stroke-dashoffset: 0; }
  }
  #submit-success svg path {
    stroke-dasharray: 16;
    stroke-dashoffset: 16;
    animation: draw-check 0.4s ease forwards;
  }
</style>

<script>
  (function () {
    const form = document.getElementById("contact-form");
    const status = document.getElementById("form-status");
    const submitBtn = document.getElementById("form-submit-btn");
    const submitText = document.getElementById("submit-text");
    const submitSpinner = document.getElementById("submit-spinner");
    const submitSuccess = document.getElementById("submit-success");
    if (!form) return;

    // ── Utility: validate a single field ──
    function validateField(field) {
      const errorEl = field.parentElement.querySelector(".form-error");
      const isValid = field.checkValidity();
      field.classList.toggle("input-error", !isValid);
      if (errorEl) errorEl.classList.toggle("hidden", isValid);
      return isValid;
    }

    // ── Validate all required fields ──
    function validateAll() {
      let valid = true;
      form.querySelectorAll("[data-validate]").forEach((field) => {
        if (!validateField(field)) valid = false;
      });
      // Select: check if valid value
      const service = document.getElementById("form-service");
      if (service && !service.value) {
        service.classList.add("input-error");
        valid = false;
      } else if (service) {
        service.classList.remove("input-error");
      }
      return valid;
    }

    // ── Clear error on input ──
    form.querySelectorAll("[data-validate]").forEach((field) => {
      field.addEventListener("input", () => {
        field.classList.remove("input-error");
        const errorEl = field.parentElement.querySelector(".form-error");
        if (errorEl) errorEl.classList.add("hidden");
      });
    });
    const serviceSelect = document.getElementById("form-service");
    serviceSelect?.addEventListener("change", () => serviceSelect.classList.remove("input-error"));

    // ── Submit ──
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Reset states
      status.classList.add("hidden");
      status.classList.remove("text-green-600", "text-red-600");

      // Validate
      if (!validateAll()) return;

      // Show loading
      submitBtn.disabled = true;
      submitText.classList.add("hidden");
      submitSpinner.classList.remove("hidden");
      submitSuccess.classList.add("hidden");

      // Collect data
      const formData = new FormData(form);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (data.success) {
          // Show success state
          submitSpinner.classList.add("hidden");
          submitSuccess.classList.remove("hidden");

          status.textContent = "Thank you! Your message has been sent. We'll get back to you within 24 hours.";
          status.classList.remove("hidden", "text-red-600");
          status.classList.add("text-green-600");
          form.reset();

          // Reset button after delay
          setTimeout(() => {
            submitSuccess.classList.add("hidden");
            submitText.classList.remove("hidden");
            submitBtn.disabled = false;
          }, 3000);
        } else {
          throw new Error(data.message || "Form submission failed");
        }
      } catch (err) {
        // Fallback: mailto
        const name = document.getElementById("form-name").value;
        const email = document.getElementById("form-email").value;
        const phone = document.getElementById("form-phone").value;
        const service = serviceSelect?.value || "";
        const message = document.getElementById("form-message").value;

        const subject = encodeURIComponent(`New Inquiry from ${name} — Ultra Wave Website`);
        const body = encodeURIComponent(
          `Name: ${name}\nEmail: ${email}\nPhone: ${phone}\nService: ${service}\n\nMessage:\n${message}`
        );

        window.location.href = `mailto:ultrawavetechnologyllc@gmail.com?subject=${subject}&body=${body}`;

        status.textContent = "Thank you! Your message has been sent. We'll get back to you shortly.";
        status.classList.remove("hidden", "text-red-600");
        status.classList.add("text-green-600");
        submitSpinner.classList.add("hidden");
        submitText.classList.remove("hidden");
        submitBtn.disabled = false;
      }
    });
  })();
</script>
