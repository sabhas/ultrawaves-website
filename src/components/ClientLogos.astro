---
import { partners } from "../content/clients";
---

<section id="partners" class="py-12 lg:py-16 bg-gray-50" aria-labelledby="partners-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-in-up" class="text-center mb-10">
      <span class="text-6xl sm:text-8xl font-bold text-gray-200 block leading-none select-none" aria-hidden="true">OUR</span>
      <h2 id="partners-heading" class="text-3xl sm:text-4xl font-bold text-brand-orange -mt-8 sm:-mt-12 relative">
        Partners
      </h2>
      <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
        Trusted technology partners enabling world-class solutions.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
      {
        partners.map((partner, i) => (
          <div
            data-animate="fade-in-up"
            data-animate-delay={i * 80}
            class="partner-card group flex items-center justify-center rounded-xl bg-dark-card border border-dark-border px-6 py-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-[var(--partner-color)]"
            style={`--partner-color: ${partner.color}`}
          >
            <span class="text-lg sm:text-xl font-bold tracking-tight text-[var(--partner-color)] transition-transform duration-300 group-hover:scale-110">
              {partner.name}
            </span>
          </div>
        ))
      }
    </div>

    <style>
      .partner-card {
        background-image: linear-gradient(
          to bottom,
          color-mix(in srgb, var(--partner-color) 6%, transparent),
          transparent 60%
        );
      }

      .partner-card:hover {
        background-image: linear-gradient(
          to bottom,
          color-mix(in srgb, var(--partner-color) 14%, transparent),
          transparent 55%
        );
      }
    </style>

    <p class="text-center mt-10 text-brand-orange font-serif italic">
      And many more...
    </p>
  </div>
</section>
