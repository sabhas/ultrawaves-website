---
import { Image } from "astro:assets";
import { projects } from "../content/projects";
import type { ImageMetadata } from "astro";

const projectImages: Record<string, ImageMetadata> = {
  "moon-tower": (await import("../assets/web/projects/moon-tower.webp")).default,
  vida: (await import("../assets/web/projects/vida.webp")).default,
  "hidd-marina": (await import("../assets/web/projects/hidd-marina.webp")).default,
  "al-durrah": (await import("../assets/web/projects/al-durrah.webp")).default,
  "executive-towers": (await import("../assets/web/projects/executive-towers.webp")).default,
  helipad: (await import("../assets/web/projects/helipad.webp")).default,
};
---

<section id="projects" class="py-12 lg:py-16" aria-labelledby="projects-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div data-animate="fade-in-up" class="text-center mb-10">
      <span class="text-6xl sm:text-8xl font-bold text-gray-200 block leading-none select-none" aria-hidden="true">OUR</span>
      <h2 id="projects-heading" class="text-3xl sm:text-4xl font-bold text-brand-blue -mt-8 sm:-mt-12 relative">
        Projects
      </h2>
    </div>

    <div class="space-y-8">
      {
        projects.map((project, i) => {
          const img = projectImages[project.id];
          return (
            <article
              data-animate="fade-in-up"
              data-animate-delay={i * 150}
              class:list={[
                "flex flex-col gap-8 rounded-2xl border border-gray-100 bg-white p-8 shadow-sm hover-lift",
                i % 2 === 1 ? "lg:flex-row-reverse" : "lg:flex-row",
              ]}
            >
              <div class="lg:w-2/5">
                <div class="aspect-[4/3] overflow-hidden rounded-xl bg-gray-100 shadow-sm ring-1 ring-gray-200/80">
                  {img && (
                    <Image
                      src={img}
                      alt={`${project.title} — ${project.subtitle}`}
                      widths={[400, 600, 900]}
                      sizes="(min-width: 1024px) 40vw, 100vw"
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  )}
                </div>
              </div>
              <div class="lg:w-3/5">
                <h3 class="text-2xl font-bold text-brand-orange font-serif mb-1">{project.title}</h3>
                <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">{project.subtitle}</p>
                <p class="text-gray-600 font-serif mb-4">{project.description}</p>
                <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">Scope of Work</h4>
                <ul class="space-y-2" role="list">
                  {
                    project.scope.map((item) => (
                      <li class="flex items-start gap-2 text-gray-600 text-sm">
                        <span class="text-brand-blue mt-0.5" aria-hidden="true">▸</span>
                        {item}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="text-center mt-12 text-gray-500 font-semibold tracking-widest uppercase">
      And many more...
    </p>
  </div>
</section>
