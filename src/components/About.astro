---
import { about, site } from "../content/site";
import aboutIllustration from "../assets/web/about-illustration.svg";
import { Image } from "astro:assets";
---

<section id="about" class="py-16 lg:py-24 bg-surface-secondary dark:bg-surface-dark-secondary transition-colors" aria-labelledby="about-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-12 lg:mb-16 animate-on-scroll">
      <span class="section-label">About Us</span>
      <h2 id="about-heading" class="section-heading">
        Who We Are
      </h2>
      <span class="heading-accent mx-auto" aria-hidden="true" />
    </div>

    <!-- Content + illustration -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
      <div class="space-y-5 animate-on-scroll reveal-left">
        {
          about.paragraphs.map((p) => (
            <p class="text-text-secondary dark:text-text-dark-secondary leading-relaxed text-base sm:text-lg">{p}</p>
          ))
        }
      </div>

      <div class="relative animate-on-scroll reveal-right visible-delay-1">
        <div class="absolute -inset-4 bg-gradient-to-r from-brand-blue/10 to-brand-gold/10 rounded-3xl blur-2xl" aria-hidden="true" />
        <div class="img-shimmer rounded-2xl">
        <Image
          src={aboutIllustration}
          alt="IT networking, connectivity, and security illustration"
          width={720}
          height={520}
          class="relative w-full rounded-2xl shadow-xl ring-1 ring-black/5 dark:ring-white/10"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {
        site.stats.map((stat, i) => (
          <div class:list={["animate-on-scroll reveal-scale", "text-center rounded-2xl bg-surface dark:bg-surface-dark-tertiary p-6 border border-border dark:border-border-dark shadow-sm transition-colors", i > 0 ? `visible-delay-${Math.min(i, 5)}` : ""]}>
            <div class="stat-number text-3xl sm:text-4xl font-bold text-brand-blue dark:text-brand-blue mb-1">{stat.number}</div>
            <div class="text-sm text-text-secondary dark:text-text-dark-secondary font-medium">{stat.label}</div>
          </div>
        ))
      }
    </div>

    <!-- Mission + Values - Compact row -->
    <div class="grid md:grid-cols-2 gap-5">
      <div class="rounded-2xl bg-surface dark:bg-surface-dark-tertiary p-6 border border-border dark:border-border-dark shadow-sm transition-colors animate-on-scroll reveal-left">
        <div class="flex items-center gap-3 mb-3">
          <div class="inline-flex items-center justify-center h-9 w-9 rounded-lg bg-brand-blue/10 dark:bg-brand-blue/20 text-brand-blue shrink-0">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-text-primary dark:text-text-dark-primary">Our Mission</h3>
        </div>
        <p class="text-sm text-text-secondary dark:text-text-dark-secondary leading-relaxed">{about.mission}</p>
      </div>
      <div class="rounded-2xl bg-surface dark:bg-surface-dark-tertiary p-6 border border-border dark:border-border-dark shadow-sm transition-colors animate-on-scroll reveal-right visible-delay-1">
        <div class="flex items-center gap-3 mb-3">
          <div class="inline-flex items-center justify-center h-9 w-9 rounded-lg bg-brand-gold/10 dark:bg-brand-gold/20 text-brand-gold shrink-0">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-text-primary dark:text-text-dark-primary">Our Values</h3>
        </div>
        <p class="text-sm text-text-secondary dark:text-text-dark-secondary leading-relaxed">{about.values}</p>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes stat-reveal {
    0% { opacity: 0; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.05); }
    100% { opacity: 1; transform: scale(1); }
  }
  .stat-number.placeholder-x {
    animation: stat-reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .stat-number.placeholder-x::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--color-brand-blue);
    margin-left: 2px;
    animation: cursor-blink 1s step-end infinite;
    vertical-align: text-bottom;
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-number.placeholder-x {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .stat-number.placeholder-x::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  (function () {
    // ── Count-up animation for stats ──
    const statNumbers = document.querySelectorAll("#about .stat-number");
    if (statNumbers.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const text = el.textContent || "";

            // Case: "X" placeholder — count up then settle on X
            if (text === "X") {
              // Pick a friendly ceiling to count up to based on the label
              const label = el.closest(".rounded-2xl")?.querySelector(".font-medium")?.textContent || "";
              const max = label.includes("Year") ? 10
                        : label.includes("Project") ? 200
                        : label.includes("Client") ? 150
                        : label.includes("Support") ? 24
                        : 99;
              const duration = 1200;
              const start = performance.now();

              function animate(now) {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.floor(eased * max);
                el.textContent = current;
                if (progress < 1) {
                  requestAnimationFrame(animate);
                } else {
                  // Resolve to "X" with placeholder styling
                  el.textContent = "X";
                  el.classList.add("placeholder-x");
                }
              }
              requestAnimationFrame(animate);
              observer.unobserve(el);
              return;
            }

            // Case: numeric value (e.g., "10+")
            const match = text.match(/([\d.]+)(\+?)/);
            if (!match) {
              // Fallback: just reveal
              el.style.opacity = "1";
              observer.unobserve(el);
              return;
            }
            const target = parseInt(match[1], 10);
            const suffix = match[2] || "";
            const duration = 1500;
            const start = performance.now();

            function animateNumeric(now) {
              const progress = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = Math.floor(eased * target);
              el.textContent = current + suffix;
              if (progress < 1) {
                requestAnimationFrame(animateNumeric);
              } else {
                el.textContent = target + suffix;
              }
            }
            requestAnimationFrame(animateNumeric);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.5 }
    );

    statNumbers.forEach((el) => observer.observe(el));
  })();
</script>
